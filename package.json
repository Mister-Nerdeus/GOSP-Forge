{
  "name": "gosp-forge",
  "version": "0.2.0",
  "private": true,
  "description": "Phase 0 baseline for a collaborative engineering challenge, reproducibility, evidence, and component-reuse platform.",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "validate:contracts": "node scripts/validation/validate-contracts.mjs",
    "benchmark:sandbox": "node packages/runner/src/cli.mjs benchmarks/sandbox-001/challenge.json benchmarks/sandbox-001/baseline-submission.json",
    "evidence:ci": "node scripts/evidence/write-ci-evidence.mjs",
    "build": "tsc -p tsconfig.build.json",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate:contracts && pnpm benchmark:sandbox && pnpm build",
    "housesim:validate": "node scripts/simulation/validate-fixtures.mjs",
    "housesim:baseline": "node scripts/simulation/simulate-baseline.mjs",
    "housesim:comparison": "node scripts/simulation/report-comparison.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
